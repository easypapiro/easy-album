# Copia questo file in .env.local e incolla i valori dalla console Firebase
# (Impostazioni progetto → Le tue app → App web → Configurazione SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL pubblico usato nel QR e nel link da condividere (facoltativo:
# se vuoto si usa l'indirizzo da cui è aperta l'app)
NEXT_PUBLIC_APP_URL=

